{
  "buildCommand": "pnpm install --frozen-lockfile=false && pnpm --filter @workspace/review-detector run build",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "env": {
    "BASE_PATH": "/",
    "PORT": "3000"
  },
  "rewrites": [
    { "source": "/ml/:path*", "destination": "/api/index" },
    { "source": "/((?!api|_vercel).*)", "destination": "/index.html" }
  ]
}
